# ─────────────────────────────────────────────────────────────
#  Carbon Footprint Platform  –  Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1

# Firebase Web SDK (used in the browser)
FIREBASE_API_KEY="AIzaSyC8MCSQ27RIGjDifNXvleomQNJ1D9uv4Gs",
FIREBASE_AUTH_DOMAIN="eco-tracker-fba6d.firebaseapp.com",
FIREBASE_PROJECT_ID="eco-tracker-fba6d",
FIREBASE_STORAGE_BUCKET="eco-tracker-fba6d.firebasestorage.app",
FIREBASE_MESSAGING_SENDER_ID="808553162203",
FIREBASE_APP_ID="1:808553162203:web:0cc2a2a73c284c6caf33fe"

# Google Maps JavaScript API (browser-only key, restrict to your domain)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Gemini AI – personalised tips (get key from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Groq AI – EcoBot chat (free tier, get key from https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# Firebase Admin SDK (server-side – path to service account JSON)
GOOGLE_APPLICATION_CREDENTIALS=serviceAccountKey.json

# Rate limiting (requests per minute per IP)
RATE_LIMIT=60
